# 数据库连接必须在本机配置，仓库中不得填写真实用户名或密码。
MATERIAL_QUALITY_DATABASE_URL=

# 阿里百炼密钥只写入.env.local，本模板不得填写真实密钥。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 所有运行产物均写入Git忽略目录。
MATERIAL_QUALITY_ONLINE_ROOT=./material_quality/.runtime/online
MATERIAL_QUALITY_MODEL_DIR=
MATERIAL_QUALITY_MODEL_VERSION=mq-quality-v1-20260824-py38
MATERIAL_QUALITY_RAW_FEATURE_VERSION=multimodal_cnclip_whisper_replayable_v4
MATERIAL_QUALITY_SCRIPT_FEATURE_VERSION=dashscope_qwen_vl_script_cnclip_v1

# 特征抽取模型配置。
MATERIAL_QUALITY_VISUAL_MODEL=RN50
MATERIAL_QUALITY_USE_MODELSCOPE=1
MATERIAL_QUALITY_ASR_MODEL=small
MATERIAL_QUALITY_ASR_COMPUTE_TYPE=int8
MATERIAL_QUALITY_SCRIPT_MODEL=qwen-vl-max

# 默认使用保守线程数，验证稳定后再逐步增加并发。
MATERIAL_QUALITY_TORCH_THREADS=2
MATERIAL_QUALITY_OCR_THREADS=2
MATERIAL_QUALITY_OCR_WORKERS=2
MATERIAL_QUALITY_ASR_THREADS=2
MATERIAL_QUALITY_ASR_WORKERS=2
MATERIAL_QUALITY_ASR_EXTRA_SLOTS=1
MATERIAL_QUALITY_USER_QUEUE_LIMIT=20

# 外部请求参数。
MATERIAL_QUALITY_LLM_TIMEOUT=180
MATERIAL_QUALITY_LLM_RETRIES=3
MATERIAL_QUALITY_LLM_FRAMES=8
